<%- include('partials/header') %>

<div class="card shadow">
    <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Lista de Jogos</h5>
        <a href="/cadastro" class="btn btn-sm btn-success">Novo Jogo</a>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Título</th>
                    <th>Plataforma</th>
                    <th>Status</th>
                    <th class="text-center">Nota</th>
                    <th class="text-center">Ações</th>
                </tr>
            </thead>
            <tbody>
                <% if (jogos.length > 0) { %>
                    <% jogos.forEach(jogo => { %>
                        <tr>
                            <td>
                                <div class="d-flex align-items-center">
                                    <img src="<%= jogo.capa_url %>" width="40" height="40" class="rounded me-3" style="object-fit: cover;" onerror="this.src='https://via.placeholder.com/40'">
                                    <strong><%= jogo.titulo %></strong>
                                </div>
                            </td>
                            <td><span class="text-muted"><%= jogo.plataforma %></span></td>
                            <td>
                                <span class="badge rounded-pill bg-opacity-10 <%= jogo.status === 'Concluído' ? 'bg-success text-success' : 'bg-primary text-primary' %>">
                                    <%= jogo.status %>
                                </span>
                            </td>
                            <td class="text-center">
                                <span class="badge bg-warning text-dark"><%= jogo.nota %></span>
                            </td>
                            <td class="text-center">
                                <a href="/deletar/<%= jogo.id %>" 
                                   class="btn btn-sm btn-danger" 
                                   onclick="return confirm('Tem certeza que deseja excluir este jogo?')">
                                   Excluir
                                </a>
                            </td>
                        </tr>
                    <% }); %>
                <% } else { %>
                    <tr>
                        <td colspan="5" class="text-center py-4 text-muted">Sua biblioteca está vazia.</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<%- include('partials/footer') %>