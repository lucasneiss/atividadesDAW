<%- include('partials/header', { tituloDaPagina: 'Publicar Edital' }) %>

<div class="row justify-content-center">
    <div class="col-md-6">
        <h2 class="mb-4">📜 Publicar Novo Edital</h2>

        <div class="card p-4 shadow-sm border-0">
          
            <form action="/salvar-missao" method="POST">

                <div class="mb-3">
                    <label class="form-label fw-bold">Título da Missão</label>
                    <input type="text" name="titulo" class="form-control"
                           placeholder="Ex: Derrotar o Dragão de Fogo" required>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Descrição Detalhada</label>
                    <textarea name="descricao" class="form-control" rows="4"
                              placeholder="Detalhes do que deve ser feito..." required></textarea>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Recompensa (Pontos de XP)</label>
                    <input type="number" name="recompensaXP" class="form-control"
                           placeholder="Ex: 500" required min="1">
                </div>

                <div class="d-grid gap-2 mt-4">
                    <button type="submit" class="btn btn-primary btn-lg">Afixar no Mural</button>
                    <a href="/" class="btn btn-outline-secondary">Cancelar e Voltar</a>
                </div>
            </form>
        </div>
    </div>
</div>

<%- include('partials/footer') %>