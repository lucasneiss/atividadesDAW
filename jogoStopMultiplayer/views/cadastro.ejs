<div class="row justify-content-center">
  <div class="col-md-6 col-lg-4">
    <div class="card shadow border-0">
      <div class="card-body p-4">
        <h1 class="h4 mb-3 fw-bold text-center text-dark">Criar Conta</h1>
        
        <% if (typeof erro !== 'undefined' && erro) { %>
          <div class="alert alert-danger py-2 small"><%= erro %></div>
        <% } %>
        
        <form method="post" action="/cadastro">
          <div class="mb-3">
            <label for="username" class="form-label small fw-semibold text-muted">Escolha um Username</label>
            <input type="text" id="username" name="username" class="form-control" placeholder="Escolha um username" required>
          </div>
          <div class="mb-3">
            <label for="senha" class="form-label small fw-semibold text-muted">Senha (Mínimo 6 caracteres)</label>
            <input type="password" id="password" name="password" class="form-control" placeholder="Escolha uma senha" required>
          </div>
          <button type="submit" class="btn btn-success w-100 fw-semibold shadow-sm">Cadastrar</button>
        </form>

        <div class="mt-4 text-center small">
          <span class="text-muted">Já possui cadastro?</span> 
          <a href="/login" class="text-decoration-none fw-semibold">Faça login</a>
        </div>
      </div>
    </div>
  </div>
</div>