<div class="row justify-content-center">
  <div class="col-md-6 col-lg-4">
    <div class="card shadow border-0">
      <div class="card-body p-4">
        <h1 class="h4 mb-3 fw-bold text-center text-dark">Acessar o Jogo</h1>
        
        <% if (typeof erro !== 'undefined' && erro) { %>
          <div class="alert alert-danger py-2 small"><%= erro %></div>
        <% } %>
        
        <form method="post" action="/login">
          <div class="mb-3">
            <label for="username" class="form-label small fw-semibold text-muted">Nome de Usuário</label>
            <input type="text" id="username" name="username" class="form-control" placeholder="Digite seu usuário" required>
          </div>
          <div class="mb-3">
            <label for="senha" class="form-label small fw-semibold text-muted">Senha</label>
            <input type="password" id="senha" name="password" class="form-control" placeholder="••••••••" required>
          </div>
          <button type="submit" class="btn btn-primary w-100 fw-semibold shadow-sm">Entrar</button>
        </form>

        <div class="mt-4 text-center small">
          <span class="text-muted">Ainda não tem conta?</span> 
          <a href="/cadastro" class="text-decoration-none fw-semibold">Cadastre-se aqui</a>
        </div>
      </div>
    </div>
  </div>
</div>